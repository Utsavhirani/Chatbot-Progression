# Copy to .env (repo root) and fill in. Never commit .env.
# Variables are added here as each V1 step introduces them.

# --- LLM provider ---------------------------------------------------------
# groq | fake   (fake = deterministic test provider, no network)
PROVIDER=groq
GROQ_API_KEY=replace-me
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Chosen from the probe results recorded in docs/providers.md
DEFAULT_MODEL=qwen/qwen3.8-27b
# Retry / timeout policy (defaults shown)
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_BACKOFF_BASE_S=0.5
PROVIDER_BACKOFF_CAP_S=8
PROVIDER_CONNECT_TIMEOUT_S=5
PROVIDER_READ_TIMEOUT_S=30
PROVIDER_TOTAL_TIMEOUT_S=120

# --- Chat / context (sized for the Groq free tier: 8000 TPM) ---------------------
CONTEXT_BUDGET_TOKENS=3000
CONTEXT_SAFETY_MARGIN_TOKENS=256
MAX_MESSAGE_CHARS=8000
CHAT_RATE_PER_MINUTE=20
STALE_STREAM_AFTER_S=300

# --- App ---------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
# Never enable in shared environments: logs message text
LOG_CONTENT=false

# --- Database (local Docker Postgres, see docker-compose.yml) -------------
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first (~2 s per connection).
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant_dev_pw
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://assistant:assistant_dev_pw@127.0.0.1:5433/assistant
TEST_DATABASE_URL=postgresql+asyncpg://assistant:assistant_dev_pw@127.0.0.1:5433/assistant_test

# --- Auth / sessions -----------------------------------------------------------
SESSION_TTL_DAYS=14
# Browser origins allowed to make state-changing requests (the Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_PER_MINUTE=5
REGISTER_RATE_PER_MINUTE=5
